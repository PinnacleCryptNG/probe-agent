# ==============================================================================
# PROBE Environment Configuration Template
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to source control.
# ==============================================================================

# Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Nansen Intelligence Provider
# Required: Nansen API key (from https://app.nansen.ai/api)
NANSEN_API_KEY=your_nansen_api_key_here
NANSEN_BASE_URL=https://api.nansen.ai

# Centralized Credit Budget & Safety Controls
# Available account credit budget (default: 1100)
CREDIT_BUDGET_TOTAL=1100
TOTAL_NANSEN_CREDIT_BUDGET=1100
# Hard limit on Nansen endpoint invocations per conversational user turn
CREDIT_MAX_CALLS_PER_TURN=4
MAX_NANSEN_CALLS_PER_TURN=4

# Telegram Bot Interface
# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: Comma-separated list of whitelisted Telegram User IDs (recommended for private/testing mode)
TELEGRAM_ALLOWED_USER_IDS=

# Webhook Deployment (Vercel)
# Optional: Secret token for verifying webhook requests from Telegram (sent via X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=f7a0eea0f8cc42eaa71b6f5e4afe053d
# Optional: Deployment base URL for registering Telegram webhook via scripts/set-webhook.ts
VERCEL_WEBHOOK_URL=https://your-probe-deployment.vercel.app

# Persistent Storage (PostgreSQL)
# Required: Database connection string
DATABASE_URL=postgresql://username:password@localhost:5432/probe_db

# Short-Lived Evidence & Query Cache
# Optional: Redis connection URI (if unset, in-memory cache is used)
REDIS_URL=redis://localhost:6379
# Cache Time-To-Live in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300
CACHE_DEFAULT_TTL_SECONDS=300

# Pluggable LLM Provider (abstracted behind ILLMProvider)
# Use 'mock' for offline development and testing (no paid LLM required)
LLM_PROVIDER=mock
# Future production providers:
# LLM_API_KEY=your_llm_api_key_here
# LLM_MODEL=gemini-3.6-flash
